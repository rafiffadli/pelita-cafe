rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff_users/$(request.auth.uid));
    }

    // 1. Menu Items: Publicly readable, writeable only by authenticated staff
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 2. Outlets & Global Settings: Publicly readable, writeable only by staff
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 3. Staff Directory: Strictly protected. Only authenticated staff can read or manage members.
    match /staff_users/{userId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // 4. Customer Orders:
    // - Public website can create order tickets with strict payload validation
    // - Customers can track only their specific order ticket via exact orderId match
    // - Full list access, status advancement, and order voiding restricted to kitchen/staff
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId == orderId
                    && request.resource.data.orderId is string
                    && request.resource.data.orderId.size() >= 6
                    && request.resource.data.orderId.size() <= 20
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() <= 100
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0
                    && request.resource.data.totalAmount <= 10000;
      allow read: if isStaff() || (resource != null && resource.data.orderId == orderId);
      allow update, delete: if isStaff();
    }
  }
}
